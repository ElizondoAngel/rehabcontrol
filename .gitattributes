# Auto-detectar texto y normalizar saltos de línea a LF en el repositorio
* text=auto eol=lf

# Forzar LF en todos los archivos de código
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.env* text eol=lf

# Archivos binarios: no tocar
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
